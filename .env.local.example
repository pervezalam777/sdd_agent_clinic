# Development environment variables
# Copy this file to .env.local and update with your values

# Application
NODE_ENV=development
PORT=3000
DB_TYPE=sqlite

# Database (PostgreSQL for dev, or sqlite for simpler setup)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent_clinic
POSTGRES_PASSWORD=agent_clinic
POSTGRES_DB=agent_clinic

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-secret-key-change-in-production-use-a-strong-secret

# Frontend (Vite)
VITE_API_URL=http://localhost:3000
