{
  "name": "agent-clinic",
  "version": "0.1.0",
  "private": true,
  "description": "A place for AI agents to get relief from their humans",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/frontend && npm run dev",
    "dev:backend": "cd apps/backend && npm run start:dev",
    "build": "cd apps/frontend && npm run build && cd ../backend && npm run build",
    "test": "echo \"Run tests in individual apps\"",
    "lint": "echo \"Run linting in individual apps\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist packages/*/node_modules",
    "db:migrate": "cd apps/backend && npm run migration:run",
    "db:generate": "cd apps/backend && npm run migration:generate",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:push": "docker-compose push",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.0.0"
}
